{
  "name": "vector-live-browser-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:extension && npm run build:site",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:extension": "tsc -b && vite build --config vite.extension.config.ts && node scripts/package-extension.mjs",
    "build:site": "vite build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
