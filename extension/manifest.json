{
  "manifest_version": 3,
  "name": "Vector Live — Crypto & Forex",
  "version": "1.0.0",
  "description": "Live crypto and forex quotes, 12-timeframe technical forecasts, historical evidence, and risk sizing. No auto-trading.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Vector Live — Market intelligence",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "alarms", "sidePanel"],
  "host_permissions": ["https://data-api.binance.vision/*", "https://api.twelvedata.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://data-api.binance.vision https://api.twelvedata.com; base-uri 'self';"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Open Vector Live"
    }
  }
}
